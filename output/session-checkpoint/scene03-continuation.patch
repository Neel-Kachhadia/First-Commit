+const CLIP_HIDDEN = "inset(0% 0% 100% 0%)";
+const CLIP_SHOWN = "inset(0% 0% 0% 0%)";
+
+const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
+const smooth = (v: number) => {
+  const t = clamp01(v);
+  return t * t * (3 - 2 * t);
+};
+const rupees = (n: number) => `₹${n.toLocaleString("en-IN")}`;
