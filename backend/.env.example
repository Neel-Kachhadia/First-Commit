# KavachPay — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env — it is already in .gitignore.

# AWS KMS Decision Receipt Signing Key
# Used for asymmetric RSASSA-PSS-SHA-256 decision receipt signing
KMS_KEY_ID=alias/kavachpay-receipt-signer

# ── AWS ────────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1

# ── Razorpay Test Mode ─────────────────────────────────────────────────────────
# Use Test Mode credentials only. Get them from:
# https://dashboard.razorpay.com/app/keys (toggle to Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret — set this in Razorpay Dashboard → Webhooks → your endpoint
RAZORPAY_WEBHOOK_SECRET=

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=4000

# ── Groq (Voice-to-Form-Fill) ──────────────────────────────────────────────────
# Free tier at https://console.groq.com
# Used for: Whisper STT (whisper-large-v3-turbo) + Llama NLU (llama-3.3-70b-versatile)
GROQ_API_KEY=
